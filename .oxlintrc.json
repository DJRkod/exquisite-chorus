{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/coverage/**"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "client/src/test/**",
        "**/*.test.tsx"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
